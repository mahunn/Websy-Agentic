# ==============================================================================
# WEBSY ENVIRONMENT CONFIGURATION (.env.local)
# ==============================================================================

# ── 1. Google Gemini AI (Required for AI Chatbot) ─────────────────────────────
# Get this from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-studio-api-key"

# ── 2. Telegram Push Notification (Free & Instant on your Phone) ─────────────
# Step 1: Create a bot with @BotFather on Telegram to get your BOT_TOKEN
# Step 2: Message your new bot or @userinfobot to get your numeric CHAT_ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── 3. Email Lead Alerts via Resend ──────────────────────────────────────────
# Step 1: Sign up free at https://resend.com and get your API Key
# Step 2: Set the email where you want to receive new lead notifications
RESEND_API_KEY=""
LEAD_NOTIFICATION_EMAIL="info@websy.bd"

# ── 4. Supabase Database Backup ──────────────────────────────────────────────
# Found in your Supabase project under Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── 5. Analytics (Optional) ──────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=""
